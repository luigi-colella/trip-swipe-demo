{
  "name": "travel-swipe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "spike:llm": "node --env-file-if-exists=.env.local --import tsx scripts/spike-llm.ts",
    "test:e2e": "playwright test",
    "test:e2e:update-screenshots": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@ai-sdk/langchain": "^3.0.173",
    "@ai-sdk/react": "^4.0.177",
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.4",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/openai": "^1.8.4",
    "ai": "^7.0.173",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "langchain": "^1.6.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^21.0.4",
    "langsmith": "^0.12.0",
    "msw": "~3.0.3",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "better-sqlite3": "$better-sqlite3"
  },
  "engines": {
    "node": ">=24"
  }
}
