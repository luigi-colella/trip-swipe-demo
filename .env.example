# Copy to .env.local and fill in. Never commit real keys.

# SQLite database file (created automatically)
DATABASE_PATH=data/app.db

# fake = offline deterministic responses (tests, UI work); live = real provider
LLM_MODE=fake

# LLM provider: OpenRouter free models - https://openrouter.ai/keys
OPENROUTER_API_KEY=
# openrouter/free routes each request to an available free model (validated by npm run spike:llm).
# To pin a specific model, pick a ":free" one with tool support:
# https://openrouter.ai/models?max_price=0&supported_parameters=tools
OPENROUTER_MODEL=openrouter/free

# Limits (LLM10). Requests sent to OpenRouter per UTC day, counted for the whole app (the free
# tier allows ~50); once used up, AI features pause until 00:00 UTC ("AI is busy").
LLM_DAILY_BUDGET=45
# Per client (IP address): chat messages per hour, and actions that may call the LLM
# (new trip, "Load more", planning) per hour. Per trip: chat messages per day.
RATE_LIMIT_CHAT_PER_HOUR=20
RATE_LIMIT_AI_ACTIONS_PER_HOUR=10
RATE_LIMIT_CHAT_PER_TRIP_PER_DAY=40

# Optional tracing - https://smith.langchain.com (free Developer plan)
# Copy the values shown by LangSmith when you set up tracing for an agent.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Only for EU workspaces: https://eu.api.smith.langchain.com (default: US API)
LANGSMITH_ENDPOINT=
# Where traces go: agent id (lowercase, digits, hyphens) + local|development|staging|production
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=
